# No API keys are needed: every model runs locally through Ollama.
# Load into your shell before running: set -a; source example.env; set +a

# Where the Ollama server listens (default below). On Colab the notebook starts it on this address.
OLLAMA_HOST=http://127.0.0.1:11434
# Lets one Ollama server run 4 requests at once, for run_eval.py --shard K/4
OLLAMA_NUM_PARALLEL=4
